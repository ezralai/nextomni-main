    "health": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -HealthCheck",
    "health:check": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -HealthCheck",
    "test:all": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -TestAll",
    "verify:all": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -VerifyAll",
    "serve:landing": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -ServeLanding",
    "serve:main": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -ServeMain",
    "serve:study": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -ServeStudy",
    "serve:life": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -ServeLife",
    "serve:intel": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -ServeIntelligence",
    "serve:finance": "powershell -ExecutionPolicy Bypass -File ./run_ecosystem.ps1 -ServeFinance"
